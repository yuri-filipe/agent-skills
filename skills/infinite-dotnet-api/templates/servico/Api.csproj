<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!--
    EF Core, Design (dotnet ef), Npgsql e NodaTime chegam transitivos pela Infinite.Core.Postgres
    (via Domain). Não referencie esses pacotes aqui: a versão do EF vem só da lib.
  -->
  <ItemGroup>
    <PackageReference Include="Infinite.Core.Consul" Version="{{versao}}" />
    <PackageReference Include="Infinite.Core.WebHost" Version="{{versao}}" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="{{versao}}" />
    <!-- Só quando houver integração HTTP externa: -->
    <!-- <PackageReference Include="Refit.HttpClientFactory" Version="{{versao}}" /> -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infinite.{{Servico}}.Domain\Infinite.{{Servico}}.Domain.csproj" />
    <ProjectReference Include="..\Infinite.{{Servico}}.Infrastructure\Infinite.{{Servico}}.Infrastructure.csproj" />
  </ItemGroup>

</Project>
