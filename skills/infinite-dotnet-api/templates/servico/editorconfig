# Destino: src/.editorconfig do serviço.
# Torna obrigatório o padrão de logs da documentação .NET
# (https://learn.microsoft.com/pt-br/dotnet/core/extensions/logging/overview).
root = true

[*.cs]
# Logs só por métodos [LoggerMessage] gerados em compilação; bloqueia LogInformation/LogError/...
# e BeginScope com template.
dotnet_diagnostic.CA1848.severity = error
# Modelo de mensagem constante: sem interpolação nem concatenação.
dotnet_diagnostic.CA2254.severity = error
# Placeholders do modelo em PascalCase.
dotnet_diagnostic.CA1727.severity = error
